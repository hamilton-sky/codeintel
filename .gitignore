__pycache__/
*.pyc
.venv/
venv/
.env
dist/
build/
*.egg-info/
.pytest_cache/

# Local codeintel semantic index cache (regenerable)
.codeintel/

# Serena LSP project cache (regenerable, created by the lsp engine backend)
.serena/

# …except inside the fixture corpora, where `project.yml` is SOURCE rather than cache: it is the
# file that tells serena which language to serve, and without it both LSP arms of
# `python bench/run.py corpus-ts` report `n/a` on a fresh clone. The arm this repo advertises as
# needing "nothing" was reproducible on one laptop only, for exactly this reason. The cache under
# it stays ignored — that part really is regenerable.
!bench/fixtures/*/.serena/
!bench/fixtures/*/.serena/project.yml
bench/fixtures/*/.serena/cache/
bench/fixtures/*/.serena/project.local.yml

# uv lockfile from `uv run` during local test/dev
uv.lock

# Pathly board exports (DB is authoritative)
pathly/**/BOARD.json
pathly/**/EVENTS.jsonl
/EVENTS.jsonl

# macOS
.DS_Store

# Tooling caches and coverage data
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/

# LikeC4 evaluation scratch: prototypes, parser probes, generated models and the real
# `likec4` npm install the evaluation ran against (133 MB of node_modules in poc/ alone).
# Local working material, not part of the shipped package.
experiments/

# Generated LikeC4 model from `codeintel c4` (regenerable; the .c4 is source you
# may instead choose to commit deliberately — see docs/c4.md)
codeintel-c4/

# Pathly editor sidecars (comments and diagrams live in the DB, same reasoning as
# BOARD.json / EVENTS.jsonl above)
pathly/**/*.comments.json
pathly/**/*.diagrams.json

# Cross-project review and spec working notes. NOT committed: this repo is public,
# and these hold security review findings for unrelated private codebases plus
# local absolute paths. Local working material, like experiments/ above.
reports/

# `codeintel index` writes a CODE_INTEL.md into whatever repository it indexes, and bench/README.md
# tells you to index the fixture corpora. The root CODE_INTEL.md above is committed deliberately;
# one inside a corpus is a generated file in a tree whose whole value is that every file in it was
# written on purpose and has a known answer.
bench/fixtures/*/CODE_INTEL.md
